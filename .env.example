# Application Configuration
APP_NAME=PostgreSQL Statistics Statements Reader
APP_VERSION=2.0.0

# Database Defaults
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres
DB_PASSWORD=123456  # Will be encrypted in settings
DB_SSL_MODE=prefer

# Logging
LOG_LEVEL=INFO

# UI Settings
DEFAULT_THEME=dark
DEFAULT_LANGUAGE=ru
USE_CUSTOM_TITLEBAR=false

# Updates
CHECK_UPDATES_ON_STARTUP=false
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=profilerPyQt

# Performance
ENABLE_QUERY_CACHE=true
CACHE_TTL_SECONDS=300
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
